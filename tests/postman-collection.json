{
	"info": {
		"_postman_id": "94e5168c-bdf4-4c00-b873-26a1a9368165",
		"name": "SIR TP1 - API de alunos",
		"description": "Testes da API (json-server ou Express). Para trocar de API basta mudar a variável baseUrl.\nCorrer a coleção pela ordem: 'Listar cursos' guarda um id de curso em cursoId e 'Criar aluno' guarda o id do aluno em alunoId, usados nos pedidos seguintes.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "baseUrl",
			"value": "http://localhost:3000"
		},
		{
			"key": "cursoId",
			"value": ""
		},
		{
			"key": "alunoId",
			"value": ""
		}
	],
	"item": [
		{
			"name": "Cursos",
			"item": [
				{
					"name": "Listar cursos",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Responde 200', () => pm.response.to.have.status(200));",
									"",
									"const cursos = pm.response.json();",
									"pm.test('Devolve uma lista', () => pm.expect(cursos).to.be.an('array'));",
									"",
									"// Guarda o id do primeiro curso para os pedidos seguintes",
									"pm.collectionVariables.set('cursoId', cursos[0].id);"
								]
							}
						}
					],
					"request": {
						"method": "GET",
						"url": "{{baseUrl}}/cursos"
					}
				},
				{
					"name": "Obter curso por id",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Responde 200', () => pm.response.to.have.status(200));",
									"pm.test('Tem o nome do curso', () => pm.expect(pm.response.json()).to.have.property('nomeDoCurso'));"
								]
							}
						}
					],
					"request": {
						"method": "GET",
						"url": "{{baseUrl}}/cursos/{{cursoId}}"
					}
				}
			]
		},
		{
			"name": "Alunos",
			"item": [
				{
					"name": "Listar alunos",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Responde 200', () => pm.response.to.have.status(200));",
									"pm.test('Devolve uma lista', () => pm.expect(pm.response.json()).to.be.an('array'));"
								]
							}
						}
					],
					"request": {
						"method": "GET",
						"url": "{{baseUrl}}/alunos"
					}
				},
				{
					"name": "Criar aluno",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Responde 201', () => pm.response.to.have.status(201));",
									"",
									"const aluno = pm.response.json();",
									"pm.test('Devolve o aluno criado', () => pm.expect(aluno.nome).to.eql('Ana'));",
									"",
									"// Guarda o id para os pedidos seguintes",
									"pm.collectionVariables.set('alunoId', aluno.id);"
								]
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"nome\": \"Ana\",\n  \"apelido\": \"Silva\",\n  \"idCurso\": \"{{cursoId}}\",\n  \"anoCurricular\": 1\n}"
						},
						"url": "{{baseUrl}}/alunos"
					}
				},
				{
					"name": "Obter aluno por id",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Responde 200', () => pm.response.to.have.status(200));",
									"pm.test('Tem os campos do aluno', () => {",
									"    pm.expect(pm.response.json()).to.include.keys('nome', 'apelido', 'idCurso', 'anoCurricular');",
									"});"
								]
							}
						}
					],
					"request": {
						"method": "GET",
						"url": "{{baseUrl}}/alunos/{{alunoId}}"
					}
				},
				{
					"name": "Atualizar aluno (PUT)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Responde 200', () => pm.response.to.have.status(200));",
									"pm.test('Apelido foi atualizado', () => pm.expect(pm.response.json().apelido).to.eql('Santos'));"
								]
							}
						}
					],
					"request": {
						"method": "PUT",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"nome\": \"Ana\",\n  \"apelido\": \"Santos\",\n  \"idCurso\": \"{{cursoId}}\",\n  \"anoCurricular\": 2\n}"
						},
						"url": "{{baseUrl}}/alunos/{{alunoId}}"
					}
				},
				{
					"name": "Atualizar só o ano (PATCH)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Responde 200', () => pm.response.to.have.status(200));",
									"pm.test('Ano foi atualizado', () => pm.expect(pm.response.json().anoCurricular).to.eql(3));"
								]
							}
						}
					],
					"request": {
						"method": "PATCH",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"anoCurricular\": 3\n}"
						},
						"url": "{{baseUrl}}/alunos/{{alunoId}}"
					}
				},
				{
					"name": "Apagar aluno",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Responde 200 ou 204', () => pm.expect(pm.response.code).to.be.oneOf([200, 204]));"
								]
							}
						}
					],
					"request": {
						"method": "DELETE",
						"url": "{{baseUrl}}/alunos/{{alunoId}}"
					}
				},
				{
					"name": "Aluno apagado já não existe",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Responde 404', () => pm.response.to.have.status(404));"
								]
							}
						}
					],
					"request": {
						"method": "GET",
						"url": "{{baseUrl}}/alunos/{{alunoId}}"
					}
				}
			]
		}
	]
}
